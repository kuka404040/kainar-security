# База данных Turso (libSQL). Локально можно не задавать — тогда используется файл database.sqlite.
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Пароль входа в админку (/admin). ОБЯЗАТЕЛЕН, иначе админка не откроется.
ADMIN_PASSWORD="придумайте-длинный-пароль"
